 {
  "id": "关联词-09",
  "category": "关联词",
  "text": "无论遇到什么困难，他却从不放弃。"
 },
 {
  "id": "关联词-10",
  "category": "关联词",
  "text": "不管条件多艰苦，他却坚持下来。"
