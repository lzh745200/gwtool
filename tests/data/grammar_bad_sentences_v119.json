  "id": "结构杂糅-13",
  "category": "结构杂糅",
  "text": "事故原因是因为违规操作造成的。"
 },
 {
  "id": "结构杂糅-14",
  "category": "结构杂糅",
  "text": "工作围绕服务群众为中心，改进作风。"
 },
 {
  "id": "结构杂糅-15",
  "category": "结构杂糅",
  "text": "对于群众诉求问题上，要做到件件有回音。"
 },
 {
  "id": "结构杂糅-16",
  "category": "结构杂糅",
  "text": "在制度建设方面上，还存在薄弱环节。"
 },
 {
  "id": "结构杂糅-17",
  "category": "结构杂糅",
  "text": "队伍包括骨干力量等组成。"
 },
 {
  "id": "结构杂糅-18",
  "category": "结构杂糅",
  "text": "任务分为两部分组成，分工推进。"
 },
 {
  "id": "结构杂糅-19",
  "category": "结构杂糅",
  "text": "之所以取得突破，是因为坚持创新的原因。"
 },
 {
  "id": "结构杂糅-20",
  "category": "结构杂糅",
  "text": "在项目推进中，使各方力量形成合力。"
 },
 {
  "id": "语义冗余-01",
  "category": "语义冗余",
  "text": "截至目前，已涉及到多个领域。"
 },
 {
  "id": "语义冗余-02",
