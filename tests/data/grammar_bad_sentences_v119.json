 {
  "id": "关联词-19",
  "category": "关联词",
  "text": "即使再忙，所以要抽时间学习。"
 },
 {
  "id": "关联词-20",
  "category": "关联词",
  "text": "无论结果如何，却也问心无愧。"
 },
 {
  "id": "结构杂糅-01",
  "category": "结构杂糅",
  "text": "这次事故的原因是管理不到位造成的。"
 },
 {
  "id": "结构杂糅-02",
  "category": "结构杂糅",
  "text": "问题是由于制度执行不严的结果。"
 },
 {
  "id": "结构杂糅-03",
  "category": "结构杂糅",
  "text": "我们本着实事求是的原则为原则开展工作。"
 },
 {
  "id": "结构杂糅-04",
  "category": "结构杂糅",
  "text": "这项工作围绕提高效率为中心展开。"
 },
 {
  "id": "结构杂糅-05",
  "category": "结构杂糅",
  "text": "对于安全生产问题上，必须高度重视。"
 },
 {
  "id": "结构杂糅-06",
  "category": "结构杂糅",
  "text": "在作风建设方面上，要持续用力。"
 },
 {
  "id": "结构杂糅-07",
  "category": "结构杂糅",
  "text": "该方案包括前期调研、论证等组成。"
 },
 {
  "id": "结构杂糅-08",
  "category": "结构杂糅",
  "text": "项目分为三个阶段组成。"
 },
 {
  "id": "结构杂糅-09",
  "category": "结构杂糅",
  "text": "他之所以成功，是因为努力的原因。"
 },
 {
  "id": "结构杂糅-10",
  "category": "结构杂糅",
  "text": "在改革过程中，使体制机制更加完善。"
 },
 {
  "id": "结构杂糅-11",
  "category": "结构杂糅",
  "text": "经过专项整治，使得市场秩序明显好转。"
 },
 {
  "id": "结构杂糅-12",
  "category": "结构杂糅",
  "text": "这次会议的目的是为了统一思想。"
