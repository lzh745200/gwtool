 {
  "id": "关联词-11",
  "category": "关联词",
  "text": "既然已经决定，所以就要坚决执行。"
 },
 {
  "id": "关联词-12",
  "category": "关联词",
  "text": "之所以取得成绩，因为大家团结。"
